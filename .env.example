# =============================================================================
# AI OPERATIONS TOOLKIT — environment configuration
#
# Copy this file to `.env` and fill in what you need:
#
#     cp .env.example .env          (macOS / Linux)
#     copy .env.example .env        (Windows)
#
# NOTHING here is required to run the app in DEMO MODE.
# Demo Mode replays previously-recorded real AI outputs, so a reviewer can
# evaluate the whole portfolio with zero API keys and zero database.
# =============================================================================


# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
APP_ENV=development                 # development | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR


# -----------------------------------------------------------------------------
# DEMO MODE  (see Section 3b of CLAUDE.md)
# -----------------------------------------------------------------------------
# true  -> AI calls replay recorded real outputs. No API key needed. No spend.
# false -> AI calls go live to the configured provider. Requires an API key.
DEMO_MODE=true

# Allow a reviewer to paste their own API key in the UI ("bring your own key").
# The key is used for that request only and is never persisted.
ALLOW_BRING_YOUR_OWN_KEY=true


# -----------------------------------------------------------------------------
# AI PROVIDER
# -----------------------------------------------------------------------------
# Which provider to use when DEMO_MODE=false: anthropic | openai | gemini
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# claude-opus-5   — most capable, $5 / $25 per million input / output tokens
# claude-sonnet-5 — cheaper, $3 / $15
# claude-haiku-4-5— cheapest, $1 / $5
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Anthropic has no embeddings or speech-to-text endpoint, so those two
# capabilities always route to a separate provider regardless of AI_PROVIDER.
# Needed by: SOP semantic search (Project 1) and the Meeting Assistant (Project 2).
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Gemini returns 3072 dimensions by default; pgvector cannot index above
# 2000, so we request a smaller vector. Changing this after SOPs exist
# means re-embedding them.
GEMINI_EMBEDDING_DIMENSIONS=1536
TRANSCRIBE_PROVIDER=openai
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Hard ceiling per single AI call, so a runaway prompt cannot burn budget.
# Claude Opus 5 thinks by default and thinking counts against this ceiling,
# so keep some headroom above the length of the answer you actually want.
AI_MAX_OUTPUT_TOKENS=24576
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2


# -----------------------------------------------------------------------------
# DATABASE  (PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
# Leave blank to run without a database. The API stays up and Demo Mode works;
# the health endpoint will simply report the database as "not_configured".
#
# Local (docker compose up db):
#   postgresql+psycopg://aiops:aiops@localhost:5432/aiops
# Managed (Supabase / Neon): paste their connection string, keep +psycopg.
DATABASE_URL=

# Auto-create tables on startup. Fine for local dev; use Alembic in production.
DB_AUTO_CREATE=false


# -----------------------------------------------------------------------------
# AUTH  (see Section 3 — interface shipped, single demo user by default)
# -----------------------------------------------------------------------------
# demo -> every request is the same demo user, no login screen.
AUTH_MODE=demo
DEMO_USER_EMAIL=demo@aiops.local
DEMO_USER_NAME=Demo Operator


# -----------------------------------------------------------------------------
# INTEGRATIONS  (see Section 3c — v1 is MOCK ONLY)
# -----------------------------------------------------------------------------
# mock -> data comes from the synthetic datasets in scripts/generate_demo_data.py
# Real OAuth (Gmail / Google Calendar) is a documented FUTURE improvement and is
# deliberately not implemented. Do not set these to anything but `mock` in v1.
EMAIL_PROVIDER=mock
CALENDAR_PROVIDER=mock
BOOKING_PROVIDER=mock


# -----------------------------------------------------------------------------
# STORAGE
# -----------------------------------------------------------------------------
# local -> files written under ./storage (gitignored)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
MAX_UPLOAD_MB=20


# -----------------------------------------------------------------------------
# FRONTEND  (Next.js)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_* values are exposed to the browser. Never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=AI Operations Toolkit

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
