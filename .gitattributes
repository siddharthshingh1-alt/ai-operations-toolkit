# Normalise line endings so the repo is identical on Windows, macOS, and Linux.
# Without this, every file committed from Windows shows up as fully changed
# when CI (Linux) touches it.
* text=auto eol=lf

# Windows-only files keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never convert.
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
